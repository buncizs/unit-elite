{
    "$schema":  "https://opencode.ai/config.json",
    "enabled_providers":  [
                              "unit-elite-runtime"
                          ],
    "model":  "unit-elite-runtime/unit-elite-runtime",
    "small_model":  "unit-elite-runtime/unit-elite-runtime",
    "provider":  {
                     "unit-elite-runtime":  {
                                                "npm":  "@ai-sdk/openai-compatible",
                                                "name":  "Unit Elite Runtime Gateway",
                                                "options":  {
                                                                "baseURL":  "http://127.0.0.1:20129/v1",
                                                                "apiKey":  "unit-elite-local"
                                                            },
                                                "models":  {
                                                               "unit-elite-runtime":  {
                                                                                          "name":  "Unit Elite Runtime"
                                                                                      }
                                                           }
                                            }
                 },
    "default_agent":  "ketua-tim",
    "subagent_depth":  1,
    "share":  "disabled",
    "permission":  {
                       "external_directory":  "ask",
                       "bash":  "ask",
                       "edit":  "ask",
                       "task_create":  "deny",
                       "task_status":  "deny",
                       "task_close":  "deny",
                       "task_cancel":  "deny",
                       "qc_record":  "deny",
                       "generate_docx":  "deny",
                       "generate_pptx":  "deny",
                       "generate_xlsx":  "deny",
                       "generate_pdf":  "deny",
                       "artifact_validate":  "deny",
                       "artifact_diagnostics":  "deny",
                       "task_add_input":  "deny",
                       "task_repair_partial_close":  "deny",
                       "contact_lookup":  "deny",
                       "communication_prepare":  "deny",
                       "communication_status":  "deny",
                       "communication_approve":  "deny",
                       "communication_dispatch_guard":  "deny",
                       "communication_record":  "deny",
                       "communication_cancel":  "deny",
                       "internal_contact_lookup":  "deny",
                       "whatsapp_bridge_diagnostics":  "deny",
                       "whatsapp_bridge_verify":  "deny",
                       "whatsapp_bridge_dispatch":  "deny",
                       "communication_diagnostics":  "deny"
                   }
}
