// ---------------------------------------------------------------------------
// Runtime gateway startup (shared across all tests)
// We start the gateway once at port 20139, pointing it at a per-test stub.
// For tests that need a specific stub, we temporarily redirect the upstream URL.
// ---------------------------------------------------------------------------

// We use a shared "mux stub" — a single stub server that routes based on
// a mutable scenario registry. This way we start the gateway only once.

let muxRequests = [];
let muxScenarios = [];
let muxStubPort = null;
let muxStubServer = null;
let gatewayServer = null;
let logBuffer = [];

function setScenarios(scenarios) {
  muxScenarios = scenarios.map((s) => Object.assign({ calls: 0 }, s));
  muxRequests = [];
}

function getRequests() {
  return muxRequests.slice();
}

async function startMuxStub() {
  return new Promise((resolve) => {
    const server = http.createServer((req, res) => {
      if (String(req.url).endsWith('/models')) {
        const data = [PRIMARY, FALLBACK].map((id) => ({
          id, object: 'model', owned_by: 'stub',
        }));
        res.writeHead(200, { 'Content-Type': 'application/json' });
        res.end(JSON.stringify({ object: 'list', data }));
        return;
      }

      let raw = '';
      req.on('data', (c) => (raw += c));
      req.on('end', () => {
        let body = null;
        try { body = JSON.parse(raw); } catch { body = null; }
        const model = body && typeof body.model === 'string' ? body.model : null;
        muxRequests.push({ model, body, url: req.url, headers: req.headers });

        const scenario = muxScenarios.find((s) => s.model === model);
        if (!scenario) {
          res.writeHead(500, { 'Content-Type': 'application/json' });
          res.end(JSON.stringify({ error: { message: 'no mux scenario for model: ' + model } }));
          return;
        }
        scenario.calls = (scenario.calls || 0) + 1;

        const respond = () => {
          try {
            if (scenario.stream) {
              res.writeHead(200, {
                'Content-Type': 'text/event-stream',
                'Cache-Control': 'no-cache',
              });
              const chunks = scenario.sseChunks || [
                { choices: [{ delta: { role: 'assistant', content: 'Hello' }, index: 0 }] },
                { choices: [{ delta: { content: ' World' }, index: 0, finish_reason: 'stop' }] },
              ];
              for (const chunk of chunks) {
                res.write('data: ' + JSON.stringify(chunk) + '\n\n');
              }
              res.write('data: [DONE]\n\n');
              res.end();
            } else {
              res.writeHead(scenario.status, { 'Content-Type': 'application/json' });
              res.end(JSON.stringify(scenario.body));
            }
          } catch { /* client aborted */ }
        };

        if (scenario.delayMs) {
          setTimeout(respond, scenario.delayMs);
        } else {
          respond();
        }
      });
    });

    server.listen(0, '127.0.0.1', () => {
      muxStubPort = server.address().port;
      muxStubServer = server;
      resolve();
    });
  });
}

// We patch the gateway's UPSTREAM_ROUTER at module level via env var before requiring.
// Since gateway is already required, we need to override its upstream lookup.
// We do this by patching the environment so buildController picks up the stub URL.
async function startTestGateway() {
  // Set UPSTREAM env to point gateway at our mux stub.
  process.env.UNIT_ELITE_UPSTREAM_URL = `http://127.0.0.1:${muxStubPort}/v1`;
  // Set a dummy API key so FallbackController doesn't log a "no key" warning.
  process.env.NINEROUTER_KEY = 'stub-test-key-not-real';

  gatewayServer = await startGateway({
    port: RUNTIME_TEST_PORT,
    host: RUNTIME_HOST,
  });
}

// Wait for gateway to accept connections.
async function waitForGateway(maxWaitMs = 3000) {
  const deadline = Date.now() + maxWaitMs;
  while (Date.now() < deadline) {
    try {
      const res = await gatewayGet('/health');
      if (res.status === 200) return;
    } catch { /* not ready yet */ }
    await new Promise((r) => setTimeout(r, 50));
  }
  throw new Error('Gateway did not become ready within ' + maxWaitMs + 'ms');
}

// ---------------------------------------------------------------------------
// SETUP: start mux stub + gateway once before all tests
// ---------------------------------------------------------------------------

async function setup() {
  // Check port 20139 is free.
  const portFree = await new Promise((resolve) => {
    const t = net.createServer();
    t.once('error', () => resolve(false));
    t.once('listening', () => t.close(() => resolve(true)));
    t.listen(RUNTIME_TEST_PORT, RUNTIME_HOST);
  });
  if (!portFree) {
    console.error(`FATAL: Test port ${RUNTIME_TEST_PORT} is already in use. Cannot run acceptance tests.`);
    process.exit(2);
  }

  await startMuxStub();
  await startTestGateway();
  await waitForGateway();
}

async function teardown() {
  if (gatewayServer) {
    await new Promise((r) => gatewayServer.close(r));
  }
  if (muxStubServer) {
    await new Promise((r) => muxStubServer.close(r));
  }
}

