// ---------------------------------------------------------------------------
// Helper: send HTTP request to runtime gateway
// ---------------------------------------------------------------------------

function httpRequest(options, body) {
  return new Promise((resolve, reject) => {
    const req = http.request(options, (res) => {
      const chunks = [];
      res.on('data', (c) => chunks.push(c));
      res.on('end', () => {
        const raw = Buffer.concat(chunks).toString('utf8');
        let parsed = null;
        try { parsed = JSON.parse(raw); } catch { parsed = null; }
        resolve({ status: res.status || res.statusCode, headers: res.headers, raw, parsed });
      });
      res.on('error', reject);
    });
    req.on('error', reject);
    if (body) req.write(typeof body === 'string' ? body : JSON.stringify(body));
    req.end();
  });
}

function gatewayGet(path) {
  return httpRequest({
    hostname: RUNTIME_HOST,
    port: RUNTIME_TEST_PORT,
    path,
    method: 'GET',
    headers: { Accept: 'application/json' },
  });
}

function gatewayPost(path, body) {
  const bodyStr = JSON.stringify(body);
  return httpRequest({
    hostname: RUNTIME_HOST,
    port: RUNTIME_TEST_PORT,
    path,
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Content-Length': Buffer.byteLength(bodyStr),
      Accept: 'application/json',
    },
  }, bodyStr);
}

// ---------------------------------------------------------------------------
// Helper: SSE streaming request to runtime gateway
// ---------------------------------------------------------------------------

function gatewayStream(path, body) {
  return new Promise((resolve, reject) => {
    const bodyStr = JSON.stringify(body);
    const req = http.request({
      hostname: RUNTIME_HOST,
      port: RUNTIME_TEST_PORT,
      path,
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Content-Length': Buffer.byteLength(bodyStr),
        Accept: 'text/event-stream',
      },
    }, (res) => {
      const chunks = [];
      res.on('data', (c) => chunks.push(c));
      res.on('end', () => {
        resolve({
          status: res.statusCode,
          headers: res.headers,
          raw: Buffer.concat(chunks).toString('utf8'),
        });
      });
      res.on('error', reject);
    });
    req.on('error', reject);
    req.write(bodyStr);
    req.end();
  });
}

// ---------------------------------------------------------------------------
// Stub 9Router factory
// ---------------------------------------------------------------------------

/**
 * scenarios: array of { model, status, body, delayMs?, stream? }
 * If stream=true, sends SSE data instead of JSON.
 */
function createStub(scenarios) {
  const requests = [];
  const server = http.createServer((req, res) => {
    if (String(req.url).endsWith('/models')) {
      const data = [PRIMARY, FALLBACK].map((id) => ({
        id, object: 'model', owned_by: 'stub',
      }));
      res.writeHead(200, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify({ object: 'list', data }));
      return;
    }

    let raw = '';
    req.on('data', (c) => (raw += c));
    req.on('end', () => {
      let body = null;
      try { body = JSON.parse(raw); } catch { body = null; }
      const model = body && typeof body.model === 'string' ? body.model : null;
      requests.push({ model, body, url: req.url, headers: req.headers });

      const scenario = scenarios.find((s) => s.model === model);
      if (!scenario) {
        res.writeHead(500, { 'Content-Type': 'application/json' });
        res.end(JSON.stringify({ error: { message: 'no stub scenario for model: ' + model } }));
        return;
      }
      scenario.calls = (scenario.calls || 0) + 1;

      const respond = () => {
        try {
          if (scenario.stream) {
            // Emit SSE stream.
            res.writeHead(200, {
              'Content-Type': 'text/event-stream',
              'Cache-Control': 'no-cache',
            });
            const chunks = scenario.sseChunks || [
              { choices: [{ delta: { role: 'assistant', content: 'Hello' }, index: 0 }] },
              { choices: [{ delta: { content: ' World' }, index: 0, finish_reason: 'stop' }] },
            ];
            for (const chunk of chunks) {
              res.write('data: ' + JSON.stringify(chunk) + '\n\n');
            }
            res.write('data: [DONE]\n\n');
            res.end();
          } else {
            res.writeHead(scenario.status, { 'Content-Type': 'application/json' });
            res.end(JSON.stringify(scenario.body));
          }
        } catch { /* client aborted */ }
      };

      if (scenario.delayMs) {
        setTimeout(respond, scenario.delayMs);
      } else {
        respond();
      }
    });
  });

  return new Promise((resolve) => {
    server.listen(0, '127.0.0.1', () => {
      const port = server.address().port;
      resolve({
        server,
        port,
        requests,
        close: () => new Promise((r) => server.close(r)),
      });
    });
  });
}

